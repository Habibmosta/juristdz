{
  "name": "juristdz-ia-juridique-algerienne",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:pbt": "jest --config jest.config.cjs --testNamePattern='Property:' --verbose",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"tests/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"tests/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "quality": "npm run type-check && npm run lint && npm run format:check",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:generate && npm run db:push",
    "migrate:supabase": "tsx scripts/migrate-from-supabase.ts",
    "setup": "bash scripts/setup-environment.sh",
    "setup:prisma": "bash scripts/setup-prisma.sh",
    "setup:full": "bash scripts/setup-environment.sh && npm run db:setup",
    "validate": "bash scripts/validate-deployment.sh",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "setup:dms": "tsx scripts/setup-document-management.ts",
    "setup:dms:sample": "tsx scripts/setup-document-management.ts --sample-data"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@google/genai": "^1.38.0",
    "@prisma/client": "^5.11.0",
    "@supabase/supabase-js": "^2.93.2",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.6.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "next-auth": "^5.0.0-beta.20",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.8",
    "@types/jspdf": "^2.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "fast-check": "^3.15.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.5",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
